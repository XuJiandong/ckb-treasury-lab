{
  "name": "@ckb-vote/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK and CLI for the CKB on-chain voting system",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "ckb-vote": "./bin/ckb-vote.ts"
